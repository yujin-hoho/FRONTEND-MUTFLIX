{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://melancholia112-mutflix.hf.space/api/:path*"
    },
    {
      "source": "/subtitle/:path*",
      "destination": "https://melancholia112-mutflix.hf.space/subtitle/:path*"
    },
    {
      "source": "/gdrive-proxy/:path*",
      "destination": "https://melancholia112-mutflix.hf.space/gdrive-proxy/:path*"
    },
    {
      "source": "/((?!assets(?:/|$)|src(?:/|$)|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ]
}
